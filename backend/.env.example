# ==============================================================================
# BankFlow AI - Environment Configuration Template (.env.example)
# Copy this file to .env and configure values appropriate for your environment.
# Never commit real credentials, production secrets, or private keys to source control.
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME="BankFlow AI"
APP_VERSION="1.0.0"
DEBUG=False
# Use 'production' for live deployments to enforce mandatory secret strength checks
ENVIRONMENT="development"

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=bankflow_ai
TEST_DB_NAME=bankflow_ai_test
# Optional direct database connection string overrides:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/bankflow_ai
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/bankflow_ai_test

# Sensitive Data Encryption (AES-256-GCM)
# Provide a 256-bit (64-character hex) key or a high-entropy secret passphrase.
# In production, must provide at least 256 bits of entropy and cannot match dev defaults.
DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# API Security, Body Size & Defensive Headers
MAX_REQUEST_BODY_SIZE_BYTES=2097152 # 2 MB maximum payload limit
ENABLE_SECURITY_HEADERS=True

# JWT Token Authentication Configuration
# Must be at least 32 characters in production. Generate using: openssl rand -hex 32
JWT_SECRET_KEY="replace-with-a-random-high-entropy-jwt-secret-minimum-32-characters"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Authentication Brute-Force Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300 # 5-minute lockout

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE="bankflow.events"
RABBITMQ_DLX_EXCHANGE="bankflow.dlx"
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_SECONDS=1.0

# Phase 8: Agent Health, Heartbeat & Timeout Configuration
AGENT_HEARTBEAT_INTERVAL_SECONDS=5.0
AGENT_HEARTBEAT_TIMEOUT_SECONDS=15.0
AGENT_PROCESSING_TIMEOUT_SECONDS=30.0

# Phase 8: Failure Recovery & Exponential Backoff Retry Policy
RECOVERY_MAX_RETRIES=3
RECOVERY_INITIAL_RETRY_DELAY_SECONDS=2.0
RECOVERY_BACKOFF_FACTOR=2.0
RECOVERY_MAX_RETRY_DELAY_SECONDS=30.0

# Phase 8: Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=10.0
CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=2

# Phase 8: Failure Simulation & Testing Harness
ENABLE_FAILURE_SIMULATION=True

# Initial Seed Bank Staff Credentials (Provisioned in development)
SEED_EMPLOYEE_USERNAME=bank_admin
SEED_EMPLOYEE_EMAIL=employee@bankflow.synthetic
SEED_EMPLOYEE_PASSWORD="Employee@2026!"
SEED_EMPLOYEE_CODE=EMP-SYN-0001
SEED_EMPLOYEE_NAME="Alexander Vance"
SEED_EMPLOYEE_DEPARTMENT="Central Operations"
SEED_EMPLOYEE_DESIGNATION="Senior Bank Officer"
SEED_EMPLOYEE_BRANCH=BR-MAIN-001

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==============================================================================
# Phase 10: Multi-Branch Federation & Cloud Architecture Configuration
# ==============================================================================
FEDERATION_ENABLED=True
FEDERATION_GATEWAY_SECRET="replace-with-a-random-gateway-root-secret-minimum-32-chars"

# Branch Dedicated Databases
BLR_DB_NAME=bankflow_ai_blr
CHE_DB_NAME=bankflow_ai_che
HYD_DB_NAME=bankflow_ai_hyd

# Branch Service Authentication Secrets (HMAC SHA-256)
BLR_BRANCH_SECRET="replace-with-secure-bengaluru-branch-secret-key"
CHE_BRANCH_SECRET="replace-with-secure-chennai-branch-secret-key"
HYD_BRANCH_SECRET="replace-with-secure-hyderabad-branch-secret-key"

# Optional Cloud Deployment Branch URL Overrides
# BLR_DATABASE_URL=postgresql+psycopg2://postgres:password@postgres-blr:5432/bankflow_ai_blr
# CHE_DATABASE_URL=postgresql+psycopg2://postgres:password@postgres-che:5432/bankflow_ai_che
# HYD_DATABASE_URL=postgresql+psycopg2://postgres:password@postgres-hyd:5432/bankflow_ai_hyd

